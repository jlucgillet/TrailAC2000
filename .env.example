# --- Base de données Supabase (PostgreSQL) ---------------------------------
# Récupérées depuis Supabase > Project Settings > Database > Connection string
# DATABASE_URL : connexion "pooled" (via PgBouncer, port 6543) — utilisée par
#   l'application en fonctionnement normal (compatible serverless Vercel).
# DIRECT_URL : connexion directe (port 5432) — utilisée uniquement par Prisma
#   pour exécuter les migrations (`prisma migrate deploy`).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# --- Sécurité ----------------------------------------------------------------
# Secret utilisé pour signer les sessions (admin + concurrent).
# Générer une valeur aléatoire de 32+ caractères, par exemple :
#   openssl rand -base64 32
SESSION_SECRET="changez-moi-avec-une-valeur-aleatoire-longue"

# --- Application ---------------------------------------------------------------
# URL publique de l'application, utilisée pour construire les URLs encodées
# dans les QR codes. En production sur Vercel : https://votre-domaine.fr
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Compte administrateur initial (utilisé par scripts/create-admin.ts) ------
ADMIN_EMAIL="organisateur@example.com"
ADMIN_PASSWORD="changez-ce-mot-de-passe"
